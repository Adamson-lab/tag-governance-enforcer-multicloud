{
  "version": "1.0.0",
  "required": {
    "owner": {"pattern": "^[a-z][a-z0-9-]{2,40}$", "inheritable": true},
    "cost-center": {"pattern": "^cc-[0-9]{4,6}$", "inheritable": true},
    "environment": {"enum": ["prod", "staging", "dev", "sandbox"], "inheritable": true},
    "application": {"pattern": "^[a-z][a-z0-9-]{2,40}$", "inheritable": true},
    "data-classification": {"enum": ["public", "internal", "confidential", "restricted"], "inheritable": false},
    "compliance-scope": {"pattern": "^(none|(pci|hipaa|sox|gdpr)(_(pci|hipaa|sox|gdpr))*)$", "inheritable": true},
    "managed-by": {"enum": ["terraform", "bicep", "pulumi", "crossplane", "manual"], "inheritable": false}
  },
  "conditional": [
    {"when": {"environment": "sandbox"}, "require": {"expiry": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}}}
  ],
  "aliases": {
    "costcenter": "cost-center", "cost_center": "cost-center", "cc": "cost-center",
    "owner": "owner", "team": "owner",
    "env": "environment", "stage": "environment",
    "app": "application", "appname": "application",
    "dataclassification": "data-classification", "data_classification": "data-classification", "classification": "data-classification",
    "compliance": "compliance-scope", "compliancescope": "compliance-scope", "compliance_scope": "compliance-scope",
    "managedby": "managed-by", "managed_by": "managed-by",
    "expires": "expiry", "expirydate": "expiry"
  },
  "reserved_prefixes": ["aws:", "microsoft.", "azure.", "goog-", "k8s.io/", "kubernetes.io/"],
  "expiry_grace_days": 7,
  "limits": {
    "aws":   {"max_tags": 50, "key_len": 128, "val_len": 256},
    "azure": {"max_tags": 50, "key_len": 512, "val_len": 256},
    "gcp":   {"max_tags": 64, "key_len": 63,  "val_len": 63}
  }
}
